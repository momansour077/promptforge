NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://promptforge:promptforge@postgres:5432/promptforge?schema=public
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MISTRAL_API_KEY=replace-with-mistral-api-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest
RATE_LIMIT_FREE_DAILY=20
RATE_LIMIT_PRO_DAILY=500
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
COOKIE_DOMAIN=localhost
ACCESS_COOKIE_NAME=promptforge_access
REFRESH_COOKIE_NAME=promptforge_refresh
CSRF_COOKIE_NAME=promptforge_csrf
LOG_LEVEL=info
PUBLIC_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=100
API_BASE_PATH=/api
VITE_API_BASE_URL=/api
